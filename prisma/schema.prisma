generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Transaction {
  id                 Int       @id @default(autoincrement())
  type               String
  description        String
  amount             Float
  category           String
  date               String
  paymentMethod      String
  cardId             Int?
  card               Card?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  installmentTotal   Int?
  installmentCurrent Int?
  createdAt          DateTime  @default(now())
}

model Card {
  id           Int           @id @default(autoincrement())
  name         String
  limit        Float
  color        String
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

model Goal {
  id            Int            @id @default(autoincrement())
  emoji         String
  name          String
  color         String
  target        Float
  deadline      String
  contributions Contribution[]
  createdAt     DateTime       @default(now())
}

model Contribution {
  id        Int      @id @default(autoincrement())
  goalId    Int
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount    Float
  date      String
  note      String   @default("")
  createdAt DateTime @default(now())
}

model Recurring {
  id            Int      @id @default(autoincrement())
  type          String
  description   String
  amount        Float
  category      String
  paymentMethod String
  dayOfMonth    Int
  cardId        Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}